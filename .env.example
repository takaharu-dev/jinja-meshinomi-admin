APP_NAME="神社めし呑み 社務所"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ローカルは Laravel Sail の MySQL コンテナ（値はダミー）
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=jinja_meshinomi
DB_USERNAME=sail
DB_PASSWORD=password
# TiDB Cloud Starter に接続するとき（TLS 必須）
# DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USERNAME=xxxxxxxx.root
# MYSQL_ATTR_SSL_CA=/etc/ssl/cert.pem  # macOS。Linux は /etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# 写真の置き場（Cloudflare R2。S3 互換）。ADMIN_PHOTO_DISK=s3 のときに使う
# キーは R2 の API トークン（Object Read & Write、対象はこのバケットだけ）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=jinja-meshinomi-photos
AWS_ENDPOINT=https://<アカウントID>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true
# 公開用のドメイン（R2 のカスタムドメイン）。写真の URL はここから作る
AWS_URL=https://img.jinja-meshinomi.com

# Laravel Sail（ホスト側に公開するポート）
APP_PORT=8000
FORWARD_DB_PORT=3306
VITE_PORT=5173

VITE_APP_NAME="${APP_NAME}"

# 管理画面の IP 制限。本番では true にして、許可する IP をカンマ区切り（CIDR 可）で並べる
# 例の値はドキュメント用のアドレス（RFC 5737）
ADMIN_IP_RESTRICTION_ENABLED=false
ADMIN_ALLOWED_IPS=192.0.2.10,198.51.100.0/24

# 写真のアップロード先のディスク。ローカルで試すだけなら public、R2 に置くなら s3
ADMIN_PHOTO_DISK=public

# admin:create で使うパスワード。空なら実行時に入力を求める
ADMIN_PASSWORD=
